<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= title || brand.name %></title>
<meta name="description" content="<%= typeof description !== 'undefined' && description ? description : brand.tagline %>">
<meta name="theme-color" content="#070a14">
<% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
<% if (config.seo.verifyGoogle) { %><meta name="google-site-verification" content="<%= config.seo.verifyGoogle %>"><% } %>

<link rel="canonical" href="<%= baseUrl %><%= currentPath %>">
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= brand.name %>">
<meta property="og:title" content="<%= title || brand.name %>">
<meta property="og:description" content="<%= typeof description !== 'undefined' && description ? description : brand.tagline %>">
<meta property="og:url" content="<%= baseUrl %><%= currentPath %>">
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap">
<link rel="stylesheet" href="/css/app.css">

<%- typeof adsHead !== 'undefined' && adsHead ? adsHead : '' %>
<% if (config.analytics.gaId) { %>
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= config.analytics.gaId %>"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','<%= config.analytics.gaId %>');</script>
<% } %>
<script>
  // Applied before first paint so the theme never flashes.
  (function(){try{var t=localStorage.getItem('lv-theme');if(t)document.documentElement.setAttribute('data-theme',t);
  else if(matchMedia('(prefers-color-scheme: light)').matches)document.documentElement.setAttribute('data-theme','light');}catch(e){}})();
</script>
</head>
<body>
<div class="aurora"></div>
<div class="grid-veil"></div>
