<nav class="nav">
  <div class="wrap nav-inner">
    <a href="/" class="logo">
      <span class="logo-mark">LV</span>
      <span><%= brand.name %></span>
    </a>

    <div class="nav-links">
      <a href="/" class="<%= currentPath === '/' ? 'on' : '' %>">Home</a>
      <a href="/pricing" class="<%= currentPath === '/pricing' ? 'on' : '' %>">Payouts</a>
      <a href="/blog" class="<%= currentPath.startsWith('/blog') ? 'on' : '' %>">Blog</a>
      <a href="/products" class="<%= currentPath.startsWith('/products') ? 'on' : '' %>">Products</a>
      <a href="/promote" class="<%= currentPath === '/promote' ? 'on' : '' %>">Promote</a>
      <a href="/about" class="<%= currentPath === '/about' ? 'on' : '' %>">About</a>
      <a href="/contact" class="<%= currentPath === '/contact' ? 'on' : '' %>">Contact</a>
    </div>

    <div class="nav-actions">
      <button class="theme-toggle" data-theme-toggle aria-label="Toggle colour theme" title="Toggle theme">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.2"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/>
        </svg>
      </button>

      <% if (user) { %>
        <a href="<%= user.role === 'admin' ? '/admin' : '/dashboard' %>" class="btn btn-sm hide-sm">
          <%= user.role === 'admin' ? 'Admin' : 'Dashboard' %>
        </a>
        <a href="/dashboard" class="avatar" title="<%= user.email %>"><%= (user.name || user.email).slice(0,1).toUpperCase() %></a>
      <% } else { %>
        <a href="/login" class="btn btn-sm btn-ghost hide-sm">Sign in</a>
        <a href="/register" class="btn btn-sm btn-primary">Start earning</a>
      <% } %>
    </div>
  </div>
</nav>

<% if (typeof announcement !== 'undefined' && announcement) { %>
  <div style="background:var(--surface-2);border-bottom:1px solid var(--line)">
    <div class="wrap" style="padding:9px 0;font-size:.85rem;color:var(--text-2);text-align:center">
      <%= announcement %>
    </div>
  </div>
<% } %>

<%- include('flash') %>
