<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<section class="section-sm">
  <div class="wrap">
    <a href="/products" class="badge mb-3" style="display:inline-flex">← All products</a>
    <div class="grid g-side">
      <div>
        <div class="row gap-2 wrapf mb-2">
          <h1 style="font-size:clamp(1.7rem,4vw,2.6rem)"><%= product.name %></h1>
          <% if (product.badge) { %><span class="badge badge-brand"><%= product.badge %></span><% } %>
        </div>
        <p class="lead"><%= product.tagline %></p>
        <% if (product.image) { %>
          <img src="<%= product.image %>" alt="<%= product.name %>" class="mt-3" style="border-radius:var(--r-lg);width:100%">
        <% } %>
        <div class="prose card mt-3"><%- bodyHtml %></div>
        <%- ads.render('site_mid') %>
      </div>

      <aside class="stack gap-3">
        <div class="card" style="position:sticky;top:calc(var(--nav-h) + 18px)">
          <div>
            <span class="price"><%= product.price_micros ? usd(product.price_micros) : 'Free' %></span>
            <span class="price-period">/ <%= product.period %></span>
          </div>
          <% if (features.length) { %>
            <ul class="feature-list mt-3"><% features.forEach(function (f) { %><li><%= f %></li><% }); %></ul>
          <% } %>
          <% if (product.url) { %>
            <a href="<%= product.url %>" target="_blank" rel="noopener" class="btn btn-primary btn-block mt-3">Get <%= product.name %></a>
          <% } else { %>
            <a href="/contact" class="btn btn-primary btn-block mt-3">Contact sales</a>
          <% } %>
          <p class="xs muted tc mt-2">Questions? <a href="/contact" style="color:var(--brand)">Talk to us</a>.</p>
        </div>

        <% if (others.length) { %>
          <div class="card card-tight">
            <div class="card-head"><span class="card-title">Also from us</span></div>
            <div class="stack gap-3">
              <% others.forEach(function (o) { %>
                <a href="/products/<%= o.slug %>" class="stack gap-1">
                  <strong style="font-size:.88rem"><%= o.name %></strong>
                  <span class="xs muted"><%= o.tagline %></span>
                </a>
              <% }); %>
            </div>
          </div>
        <% } %>
      </aside>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
<%- include('../partials/foot') %>
