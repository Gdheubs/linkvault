<%- include('../partials/head', { noindex: true }) %>
<%- include('../partials/nav') %>
<div class="app">
  <%- include('../partials/adminside') %>
  <main class="main">
    <div class="page-head">
      <div><h1>Links</h1><p class="muted"><%= num(total) %> link<%= total === 1 ? '' : 's' %> across the platform.</p></div>
    </div>

    <form method="get" class="row gap-2 wrapf mb-3">
      <input class="input" name="q" placeholder="Code, destination, title or owner email…" value="<%= search %>" style="max-width:340px">
      <select class="select" name="status" style="max-width:160px">
        <option value="">Any status</option>
        <% ['active','paused','blocked'].forEach(function (s) { %>
          <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option>
        <% }); %>
      </select>
      <button class="btn">Filter</button>
      <% if (search || status) { %><a href="/admin/links" class="btn btn-ghost">Reset</a><% } %>
    </form>

    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Link</th><th>Owner</th><th>Target</th><th class="num">Clicks</th>
              <th class="num">Done</th><th class="num">Revenue</th><th>Status</th><th>Moderate</th></tr>
        </thead>
        <tbody>
          <% links.forEach(function (l) { %>
            <tr>
              <td>
                <div style="font-weight:600"><%= truncate(l.title || l.code, 28) %></div>
                <a href="/s/<%= l.code %>" target="_blank" rel="noopener" class="code-chip">/s/<%= l.code %> ↗</a>
              </td>
              <td class="small"><a href="/admin/users/<%= l.user_id %>" style="color:var(--brand)"><%= truncate(l.email, 24) %></a></td>
              <td class="small muted truncate" style="max-width:190px">
                <%= l.resource_id ? '▤ ' + (l.file_name || 'vault file') : (l.destination ? hostOf(l.destination) : '—') %>
              </td>
              <td class="num"><%= num(l.clicks) %></td>
              <td class="num"><%= num(l.completed_visits) %></td>
              <td class="num"><%= usd(l.revenue_micros) %></td>
              <td><span class="badge <%= l.status === 'active' ? 'badge-ok' : l.status === 'blocked' ? 'badge-danger' : 'badge-warn' %>"><%= l.status %></span></td>
              <td>
                <form method="post" action="/admin/links/<%= l.id %>/status" class="row gap-1">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <select class="select" name="status" style="padding:4px 24px 4px 8px;font-size:.76rem">
                    <% ['active','paused','blocked'].forEach(function (s) { %>
                      <option value="<%= s %>" <%= l.status === s ? 'selected' : '' %>><%= s %></option>
                    <% }); %>
                  </select>
                  <button class="btn btn-xs">Set</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (pages > 1) { %>
      <div class="pagination">
        <% for (let i = 1; i <= pages; i++) { %>
          <a href="?page=<%= i %><%= search ? '&q=' + encodeURIComponent(search) : '' %><%= status ? '&status=' + status : '' %>" class="<%= i === page ? 'on' : '' %>"><%= i %></a>
        <% } %>
      </div>
    <% } %>
  </main>
</div>
<%- include('../partials/foot') %>
