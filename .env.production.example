# Minimum env for a container deploy. Set these in the Railway/Render dashboard.
# Everything else falls back to a sane default — see .env.example for the rest.

NODE_ENV=production

# Behind a platform proxy, so the real client IP comes from X-Forwarded-For.
# Without this every visitor looks like one IP and the fraud engine flags them.
TRUST_PROXY=1

# Railway and Render inject their public URL automatically and config.js picks
# it up, so only set this if you are using a custom domain.
# BASE_URL=https://yourdomain.com

# Required — production refuses to boot without all three.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
TOKEN_SECRET=
HASH_SALT=

# Must point at the mounted volume.
DB_FILE=/app/data/linkvault.db

BRAND_NAME=LinkVault
SUPPORT_EMAIL=support@yourdomain.com
DMCA_EMAIL=dmca@yourdomain.com

# Optional integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_STORAGE_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
ADSENSE_CLIENT=
ADSENSE_ENABLED=false
