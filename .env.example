# ==========================================================================
#  LinkVault — copy to .env and fill in.
#  In production the three secrets below are MANDATORY; the app refuses to
#  boot without them. In development they are generated and cached for you.
# ==========================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Your public origin, no trailing slash. Used in short links, OG tags,
# the sitemap and the Telegram webhook URL.
BASE_URL=https://yourdomain.com

# Set to 1 when running behind nginx / Cloudflare / a load balancer, so the
# real client IP is read from X-Forwarded-For instead of the proxy's address.
TRUST_PROXY=1

# --- secrets --------------------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating SESSION_SECRET signs everyone out. Rotating TOKEN_SECRET invalidates
# every in-flight unlock token. Rotating HASH_SALT breaks unique-visitor and
# repeat-click detection against historical data — treat it as permanent.
SESSION_SECRET=
TOKEN_SECRET=
HASH_SALT=

# --- branding -------------------------------------------------------------
BRAND_NAME=LinkVault
BRAND_TAGLINE=Monetized short links with vault-grade file delivery
COMPANY_NAME=LinkVault Media
COMPANY_ADDRESS=
SUPPORT_EMAIL=support@yourdomain.com
DMCA_EMAIL=dmca@yourdomain.com
SOCIAL_TWITTER=
SOCIAL_TELEGRAM=
SOCIAL_YOUTUBE=

# --- monetization ---------------------------------------------------------
WAIT_SECONDS=15

# The shipped flow is 'none': the timer runs at the top of the page, then the
# Continue button at the bottom unlocks by itself. Nothing is asked of the
# visitor, and no ad interaction is ever required or rewarded.
#
#   none        timer only. The default, and what the seeded campaign uses.
#   engagement  additionally allow an early skip once the visitor has engaged
#               with the PAGE CONTENT. Still AdSense-safe.
#   ad_click    allow an early skip on an AD interaction. This is an
#               incentivised click and the Google AdSense program policies
#               PROHIBIT it — it risks account termination. Only for a network
#               whose terms explicitly permit it.
SKIP_MODE=none

# Minimum time on a step before a skip can be granted, in ms.
MIN_DWELL_MS=2500
# How long a step token stays valid (seconds).
STEP_TOKEN_TTL=1800
# How long an unlock token stays valid, and how many times it may be redeemed.
# A small allowance above 1 absorbs flaky mobile connections and retried taps
# without meaningfully helping an abuser.
COMPLETION_TOKEN_TTL=900
COMPLETION_MAX_USES=3

# --- revenue --------------------------------------------------------------
PUBLISHER_SHARE_PCT=60
# Referral share is taken from the PLATFORM's cut, never the publisher's.
REFERRAL_SHARE_PCT=5
# Earnings sit in `pending` this long before becoming withdrawable, so a fraud
# sweep can still reverse them.
EARNINGS_HOLD_HOURS=72
MIN_PAYOUT_USD=5

# --- anti-fraud -----------------------------------------------------------
# A visit at or above REJECT earns nothing; at or above REVIEW it is paid at a
# reduced rate. Raise these if you see false positives on legitimate traffic.
FRAUD_REJECT_SCORE=60
FRAUD_REVIEW_SCORE=35
UNIQUE_WINDOW_HOURS=24
# Careful with these two: carrier-grade NAT means a whole mobile network can
# share one address. Too low and you punish entire countries.
IP_VISITS_PER_MIN=12
IP_VISITS_PER_HOUR=120
MIN_HUMAN_COMPLETION_MS=4000
PUB_ANOMALY_MIN_VISITS=200

# --- Telegram media bot ---------------------------------------------------
# Create the bot with @BotFather. Leave blank to run without file delivery —
# links with a plain destination URL work either way.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# A private channel or group the bot is an admin of, used as the storage vault.
TELEGRAM_STORAGE_CHAT_ID=
# Random string; Telegram sends it back in a header so the webhook can verify.
TELEGRAM_WEBHOOK_SECRET=

# --- advertising ----------------------------------------------------------
# Until ADSENSE_ENABLED is true, every adsense-provider slot renders a sized
# placeholder so your layout is identical before and after approval.
ADSENSE_CLIENT=
ADSENSE_ENABLED=false
# Optional: override the generated /ads.txt with your own full contents.
ADS_TXT=

# --- analytics / SEO ------------------------------------------------------
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# --- storage --------------------------------------------------------------
DB_FILE=./data/linkvault.db
SESSION_TTL_DAYS=30
